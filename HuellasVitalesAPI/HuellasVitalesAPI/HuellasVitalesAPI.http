### ==========================================
### 1. LOGIN (Guarda el token automáticamente)
### ==========================================
# @name loginRequest
POST http://localhost:5010/api/Login/local
Content-Type: application/json

{
  "correo": "eduaba8@gmail.com",
  "password": "1234"
}

### ------------------------------------------
### VARIABLE DINÁMICA DEL TOKEN
### (Extrae la propiedad 'token' de la respuesta del Login)
### ------------------------------------------
@authToken = {{loginRequest.response.body.token}}


### ==========================================
### 2. AGREGAR PRODUCTO AL CARRITO
### ==========================================
POST http://localhost:5010/api/Carrito/agregar
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "idProducto": 3,
  "cantidad": 2
}


### ==========================================
### 3. AGREGAR CON CANTIDAD POR DEFECTO (1)
### ==========================================
POST http://localhost:5010/api/Carrito/agregar
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "idProducto": 1
}